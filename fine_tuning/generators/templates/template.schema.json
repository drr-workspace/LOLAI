{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template.schema.json",
  "title": "LOLAI causal template document",
  "description": "Declarative families and reusable blueprints for deterministic scenario construction.",
  "type": "object",
  "properties": {
    "templateVersion": {"type": "string", "minLength": 1},
    "ontologyVersion": {"type": "string", "minLength": 1},
    "task": {"type": "string", "enum": ["ITEMIZATION_DECISION", "THREAT_ASSESSMENT", "COMPOSITION_PLAN", "MATCHUP_PLAN", "MACRO_PRIORITY", "ADVICE_SUPPRESSION"]},
    "blueprintCatalog": {
      "type": "object",
      "properties": {
        "contexts": {"$ref": "#/$defs/profileMap"},
        "teamPlans": {"$ref": "#/$defs/profileMap"},
        "evidence": {"$ref": "#/$defs/profileMap"},
        "threats": {"$ref": "#/$defs/profileMap"},
        "candidates": {"$ref": "#/$defs/profileMap"},
        "recentAdvice": {"$ref": "#/$defs/profileMap"}
      },
      "required": ["contexts", "teamPlans", "evidence", "threats", "candidates", "recentAdvice"],
      "additionalProperties": false
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/family"}
    }
  },
  "required": ["templateVersion", "ontologyVersion", "task", "blueprintCatalog", "families"],
  "additionalProperties": false,
  "$defs": {
    "profileMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": ["object", "array"]}
    },
    "profileReference": {
      "type": "object",
      "properties": {
        "profile": {"type": "string", "minLength": 1}
      },
      "required": ["profile"],
      "additionalProperties": false
    },
    "axis": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {"type": ["string", "number", "integer", "boolean", "null"]}
        }
      },
      "required": ["id", "description", "field", "values"],
      "additionalProperties": false
    },
    "edgeCase": {
      "type": "object",
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "causalParameterId": {"type": "string", "minLength": 1},
        "contextProfile": {"type": "string", "minLength": 1},
        "teamPlanProfile": {"type": "string", "minLength": 1},
        "evidenceProfile": {"type": "string", "minLength": 1},
        "threatProfile": {"type": "string", "minLength": 1},
        "candidateProfile": {"type": "string", "minLength": 1},
        "recentAdviceProfile": {"type": "string", "minLength": 1},
        "expectedDecisionConstraints": {
          "$ref": "#/$defs/decisionConstraints"
        },
        "allowedReasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": [
        "description",
        "causalParameterId",
        "contextProfile",
        "teamPlanProfile",
        "evidenceProfile",
        "threatProfile",
        "candidateProfile",
        "recentAdviceProfile",
        "expectedDecisionConstraints",
        "allowedReasonCodes"
      ],
      "additionalProperties": false
    },
    "decisionConstraints": {
      "type": "object",
      "properties": {
        "decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "triggeredGates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "selectedCandidateRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["decisions", "triggeredGates", "selectedCandidateRoles"],
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "properties": {
        "familyId": {"type": "string", "minLength": 1},
        "task": {"type": "string", "enum": ["ITEMIZATION_DECISION", "THREAT_ASSESSMENT", "COMPOSITION_PLAN", "MATCHUP_PLAN", "MACRO_PRIORITY", "ADVICE_SUPPRESSION"]},
        "description": {"type": "string", "minLength": 1},
        "invariantPrinciple": {"type": "string", "minLength": 1},
        "splitGroup": {"type": "string", "minLength": 1},
        "sourceEligibility": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "parameterRanges": {
          "type": "object",
          "properties": {
            "contextProfile": {"type": "string", "minLength": 1},
            "teamPlanProfile": {"type": "string", "minLength": 1},
            "seed": {
              "type": "object",
              "properties": {
                "minimum": {"type": "integer"},
                "maximum": {"type": "integer"}
              },
              "required": ["minimum", "maximum"],
              "additionalProperties": false
            }
          },
          "required": ["contextProfile", "teamPlanProfile", "seed"],
          "additionalProperties": false
        },
        "requiredContextFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidenceBlueprints": {"$ref": "#/$defs/profileReference"},
        "threatBlueprints": {"$ref": "#/$defs/profileReference"},
        "candidateBlueprints": {"$ref": "#/$defs/profileReference"},
        "recentAdviceBlueprint": {"$ref": "#/$defs/profileReference"},
        "expectedDecisionConstraints": {"$ref": "#/$defs/decisionConstraints"},
        "allowedReasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "counterfactualAxes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/axis"}
        },
        "adversarialAxes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/axis"}
        },
        "causalParameters": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/axis"}
        },
        "edgeCase": {"$ref": "#/$defs/edgeCase"},
        "usefulChange": {
          "type": "string",
          "minLength": 1
        },
        "insufficientChange": {
          "type": "string",
          "minLength": 1
        },
        "semanticComparisonFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reenablingRecheckTriggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "messageIntents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "minimumExamples": {"type": "integer", "minimum": 1},
        "maximumExamples": {"type": "integer", "minimum": 1}
      },
      "required": [
        "familyId",
        "task",
        "description",
        "invariantPrinciple",
        "splitGroup",
        "sourceEligibility",
        "parameterRanges",
        "requiredContextFields",
        "evidenceBlueprints",
        "threatBlueprints",
        "candidateBlueprints",
        "recentAdviceBlueprint",
        "expectedDecisionConstraints",
        "allowedReasonCodes",
        "counterfactualAxes",
        "adversarialAxes",
        "messageIntents",
        "minimumExamples",
        "maximumExamples"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "task": {
                "enum": ["MACRO_PRIORITY", "ADVICE_SUPPRESSION"]
              }
            },
            "required": ["task"]
          },
          "then": {
            "required": [
              "usefulChange",
              "insufficientChange",
              "semanticComparisonFields",
              "reenablingRecheckTriggers"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
